# ─────────────────────────────────────────────────────────────────
# Lead Dispatcher — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Every REQUIRED var MUST be set — the
# server will refuse to start if JWT_SECRET or ENCRYPTION_KEY is missing
# or too short.

# ─── DATABASE (REQUIRED) ─────────────────────────────────────────
# Neon Postgres connection string (free tier: https://neon.tech)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/lead-dispatcher?sslmode=require

# ─── AUTH (REQUIRED) ─────────────────────────────────────────────
# JWT secret for signing auth tokens. The server REFUSES TO START if
# this is missing or shorter than 16 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-hex-string

# ─── CREDENTIAL ENCRYPTION (REQUIRED) ────────────────────────────
# AES-256-GCM master key for encrypting SMTP/IMAP passwords.
# The server REFUSES TO START if this is missing or shorter than 16 chars.
# Generate with: openssl rand -hex 32
# WARNING: If this changes after credentials are stored, those credentials
# become unreadable (decryption throws) and must be re-entered.
ENCRYPTION_KEY=replace-with-64-char-random-hex-string

# ─── CORS (REQUIRED) ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# After Vercel deploys, set this to your Vercel URL.
FRONTEND_URL=https://cold-outreach-frontend.vercel.app

# ─── PUBLIC URL (REQUIRED) ───────────────────────────────────────
# Used for unsubscribe links in email footers + click-tracking redirects.
# Set to your Vercel frontend URL.
PUBLIC_BASE_URL=https://cold-outreach-frontend.vercel.app

# ─── CRON SECRET (REQUIRED for worker) ───────────────────────────
# Secret in the URL path that protects the /api/cron/:secret endpoint.
# Generate at https://www.random.org/strings (Length 32, Alphanumeric).
# Cloud Scheduler calls /api/cron/<CRON_SECRET> every 5 minutes.
CRON_SECRET=replace-with-random-alphanumeric-string

# ─── EMAIL VERIFICATION (OPTIONAL but recommended) ──────────────
# Domain used for SMTP-level mailbox verification (HELO + MAIL FROM).
# If set, we use verify@<VERIFICATION_DOMAIN> for the MAIL FROM. If NOT
# set, we use empty MAIL FROM (<>), which is RFC 5321 § 4.5.5 compliant
# for bounces and reduces the chance of being flagged as a spammer.
# Use a subdomain you control that has a valid A record, e.g.
#   VERIFICATION_DOMAIN=verify.yourdomain.com
VERIFICATION_DOMAIN=

# ─── THIRD-PARTY EMAIL VERIFICATION API (REQUIRED for SMTP mailbox check on Render) ──
# Render (and AWS/GCP/Azure/Heroku) BLOCK outbound port 25, so direct SMTP
# mailbox verification is impossible from these hosts. To get real SMTP
# verification working (required for a lead to be marked VERIFIED), you MUST
# configure a third-party verification API. These services run their own
# infrastructure with port 25 unblocked and perform the real SMTP check.
#
# Cost: ~$5-9 per 1,000 emails (varies by provider).
#
# Supported providers:
#   kickbox     — $0.005/email, free 100/mo  → https://kickbox.com
#   zerobounce  — $0.006/email, free 100/mo  → https://zerobounce.net
#   abstract    — $0.009/email, free 100/mo  → https://abstractapi.com
#
# Setup:
#   1. Sign up at one of the providers above (no terminal — all browser-based)
#   2. Copy your API key from their dashboard
#   3. Set EMAIL_VERIFY_PROVIDER to one of: kickbox | zerobounce | abstract
#   4. Set EMAIL_VERIFY_API_KEY to your API key
#   5. Redeploy on Render
#
# If both are empty/unset, the verifier falls back to direct SMTP (only
# works on hosts that allow port 25 — NOT Render). Without a provider,
# NO leads can be VERIFIED — they'll all be RISKY because SMTP can't run.
EMAIL_VERIFY_PROVIDER=
EMAIL_VERIFY_API_KEY=

# ─── DEEPSEEK LLM (OPTIONAL) ────────────────────────────────────
# For reply sentiment tagging (interested / not_interested / ooo /
# unsubscribe / neutral). Get your API key at: https://platform.deepseek.com
# If not set, LLM tagging is disabled — replies default to "neutral".
# The LLM call has a 15s timeout; on any error it falls back to neutral.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ─── REALTIME (OPTIONAL) ────────────────────────────────────────
# URL of the standalone socket.io realtime service that broadcasts
# notifications to connected frontend clients. If not set, notifications
# are still persisted to the DB (clients see them on next poll).
# In sandbox: defaults to http://localhost:3003
# In production: set to your realtime service's public URL.
REALTIME_PUBLISHER_URL=http://localhost:3003
# Port the realtime service listens on (informational only — used by
# the realtime service, not the backend).
REALTIME_PORT=3003

# ─── VERIFICATION CONCURRENCY (OPTIONAL) ────────────────────────
# How many leads to verify in parallel in the worker's verification
# batch. Higher = faster but more DNS / SMTP connections. Default 10.
VERIFY_CONCURRENCY=10

# ─── NODE_ENV ───────────────────────────────────────────────────
# Set to "production" to strip internal error detail from API
# responses (full error still logged server-side). Defaults to
# "development" (errors include `detail: err.message`).
NODE_ENV=production

# ─── PORT (Auto-set by Render / Cloud Run) ──────────────────────
# Render sets this automatically (usually 10000).
# Cloud Run sets this to 8080. For local dev, defaults to 3001.
# PORT=8080
